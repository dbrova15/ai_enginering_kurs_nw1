# Скопіюйте файл у .env та заповніть ключ і модель активного провайдера
# Допустимі значення: openrouter, openai, ollama; типово openrouter
# Значення читається з оточення/.env, редагувати main.py не потрібно
LLM_PROVIDER=openrouter

# Налаштування OpenRouter; потрібні тільки коли він активний
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=

# Налаштування прямого OpenAI API; потрібні тільки при LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=

# Локальна Ollama; API-ключ не потрібний, модель треба попередньо завантажити
OLLAMA_MODEL=llama3.2:3b
# Коренева адреса сервера без /v1 та /api/chat
OLLAMA_BASE_URL=http://localhost:11434

# Timeout мережевої операції в секундах; retry не включає початковий запит
REQUEST_TIMEOUT_SECONDS=60
MAX_RETRIES=2

# Обраний endpoint має підтримувати ці параметри та JSON Schema
TEMPERATURE=0
TOP_P=1
# Необов'язковий ліміт відповіді; без значення max_tokens не передається
# MAX_TOKENS=4096
